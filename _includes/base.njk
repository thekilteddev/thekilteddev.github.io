<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{# Open Graph / Twitter cards. Without these a shared link renders as a bare URL with no title
   card, no standfirst and no image — the weakest possible version of a link on a feed built to
   reward cards. og:image must be an ABSOLUTE url; relative paths are silently ignored by every
   scraper. Posts may override with an `ogImage` frontmatter path; otherwise the site-wide card
   (brand/banner rendered at 1200x630 by tools/cards/render-banner.mjs) is used. #}
<meta property="og:type" content="{% if title %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/og-default.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/og-default.png' }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700&family=JetBrains+Mono:wght@400;700&family=Spectral:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f4f6f3; --bg-raised: #ffffff; --ink: #1c2523; --ink-dim: #5c6a66;
    --loch: #146e63; --moss: #5f7d3d; --rule: #d6ddd8;
    --good: #2e7d4f; --warn: #a86a1e; --bad: #a3452f;
    --panel: #16211f; --panel-ink: #d7ded9;
    --font-display: "Archivo", "Segoe UI Variable Display", system-ui, sans-serif;
    --font-body: "Spectral", Georgia, "Segoe UI", serif;
    --font-mono: "JetBrains Mono", Consolas, monospace;
    --col: 720px;
  }
  /* Dark theme carries the settled Kilted Dev identity palette (deep green / emerald / sage) —
     light theme deliberately keeps the prior Loch & Moss values (user call, 2026-07-18). */
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1310; --bg-raised: #16211f; --ink: #eef1ec; --ink-dim: #93a096;
      --loch: #4db892; --moss: #8fb46f; --rule: #25322f;
      --good: #5fb37e; --warn: #d3944a; --bad: #c9705a;
      --panel: #0a1211; --panel-ink: #cdd6d1;
    }
  }
  :root[data-theme="light"] {
    --bg: #f4f6f3; --bg-raised: #ffffff; --ink: #1c2523; --ink-dim: #5c6a66;
    --loch: #146e63; --moss: #5f7d3d; --rule: #d6ddd8;
    --good: #2e7d4f; --warn: #a86a1e; --bad: #a3452f;
    --panel: #16211f; --panel-ink: #d7ded9;
  }
  :root[data-theme="dark"] {
    --bg: #0b1310; --bg-raised: #16211f; --ink: #eef1ec; --ink-dim: #93a096;
    --loch: #4db892; --moss: #8fb46f; --rule: #25322f;
    --good: #5fb37e; --warn: #d3944a; --bad: #c9705a;
    --panel: #0a1211; --panel-ink: #cdd6d1;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: var(--font-body); font-size: 18px; line-height: 1.65; font-weight: 400;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  }
  .wrap { max-width: var(--col); margin: 0 auto; padding: 0 24px; }
  header.masthead { border-bottom: 1px solid var(--rule); }
  .masthead .wrap {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 20px; padding-bottom: 20px; gap: 12px;
  }
  .wordmark {
    font-family: var(--font-mono); font-weight: 700; font-size: 18px;
    letter-spacing: -0.01em; color: var(--ink); text-decoration: none;
    display: inline-flex; align-items: center;
  }
  /* The mark: U+203A, set as type so it inherits weight/scale and needs no per-theme colour.
     Chosen over U+003E, which rides the maths axis and reads as an operator beside lowercase. */
  .wm-mark { color: var(--loch); margin-right: 0.45ch; }
  .wm-the { color: var(--moss); }
  .wm-kilted { color: var(--ink); }
  .wm-dev { color: var(--loch); }
  .wm-cursor {
    display: inline-block; width: 0.5em; height: 1em; margin-left: 2px;
    background: var(--loch); animation: wm-blink 1.1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) { .wm-cursor { animation: none; } }
  @keyframes wm-blink { 50% { opacity: 0; } }
  .hy { color: var(--moss); }
  .masthead-nav { display: flex; align-items: center; gap: 18px; }
  .masthead-nav a {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
    color: var(--ink-dim); text-transform: uppercase; text-decoration: none;
  }
  .masthead-nav a:hover { color: var(--loch); }
  .theme-toggle {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-dim); background: transparent;
    border: 1px solid var(--rule); border-radius: 6px; padding: 6px 10px; cursor: pointer;
    transition: border-color .15s ease, color .15s ease;
  }
  .theme-toggle:hover { border-color: var(--loch); color: var(--loch); }
  .theme-toggle:focus-visible { outline: 2px solid var(--loch); outline-offset: 2px; }
  main { padding-bottom: 96px; }
  section { padding-top: 56px; }
  h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(34px, 6vw, 50px); line-height: 1.08; letter-spacing: -0.025em;
    margin: 0 0 16px; text-wrap: balance;
  }
  h2 {
    font-family: var(--font-display); font-weight: 700; font-size: 27px;
    letter-spacing: -0.015em; line-height: 1.2; margin: 0 0 8px; text-wrap: balance;
  }
  h2 .h2-num {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.06em; color: var(--loch); display: block; margin-bottom: 12px;
  }
  p { margin: 0 0 20px; }
  main a { color: var(--loch); text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }
  code, .mono { font-family: var(--font-mono); font-size: 0.9em; }
  /* NO background behind prose text, inline code included. Settled on a render S11 after two
     wrong turns: the chip was first loch-tinted, then retinted neutral, and neutral was still a
     highlight — the fault was the box, never the hue. JetBrains Mono against Spectral serif is
     already a hard contrast, so the face was carrying the "this is code" signal the whole time and
     the background was decoration. Removing it also fixes the punctuation: a 5px right pad put a
     visible gap between the chip and the following comma, which read as a stray space.
     <pre> keeps its panel — a block container is a different thing from a word in a sentence. */
  p code, li code { background: none; padding: 0; }

  /* Markdown block elements, added for short-form posts (the first posts authored as .md).
     The three hand-written HTML posts contain no <pre> and no <blockquote>, so nothing
     already published changed when these were added. (Inline <code> WAS later changed, S11 —
     see the rule above.) R4 holds — <pre> takes raised fill + radius and no
     border (two of three); <blockquote> takes one border and nothing else. */
  pre {
    background: var(--bg-raised); border-radius: 6px; padding: 16px 18px;
    margin: 0 0 24px; line-height: 1.5;
    overflow-x: auto; /* the BLOCK scrolls so the PAGE never does */
  }
  pre code { background: none; padding: 0; font-size: 13px; }
  blockquote {
    margin: 0 0 24px; padding-left: 20px;
    border-left: 2px solid var(--rule); color: var(--ink-dim);
  }
  blockquote p { margin-bottom: 12px; }
  blockquote p:last-child { margin-bottom: 0; }
  /* table: first use is the benchmark grid in "what-really-fits-in-8gb-vram" (S13). No fill, no
     radius, one rule per row — same no-container family as blockquote. Numeric-looking columns
     stay body face; the data is the emphasis, not a device. */
  table {
    width: 100%; border-collapse: collapse; margin: 0 0 24px; font-size: 15px;
    overflow-x: auto; display: block;
  }
  thead, tbody, tr { display: table; width: 100%; table-layout: fixed; }
  th, td { text-align: left; padding: 10px 16px 10px 0; border-bottom: 1px solid var(--rule); }
  thead th {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim); padding-bottom: 8px;
  }
  .kicker {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--loch); margin: 0 0 20px;
  }
  .article-head { padding-top: 40px; padding-bottom: 8px; }
  .standfirst {
    font-size: 20px; line-height: 1.55; color: var(--ink-dim);
    font-style: italic; margin: 0; max-width: 40ch;
  }
  /* article meta row: date · read-time · [last reviewed] · tags */
  .meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0 10px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--ink-dim); margin-top: 24px;
    padding-top: 14px; border-top: 1px solid var(--rule);
  }
  .meta .sep { color: var(--rule); }
  .meta .read { color: var(--loch); }
  .meta .rev b { color: var(--ink); font-weight: 400; }
  /* No prose-highlight device. <mark> was retired S10 and its last instance removed S11.
     The rule that replaced it is about the COLOUR, not the tag: nothing in body prose takes an
     accent-tinted background, because loch is the link colour and moss means "named evaluated
     entity", so either one painted behind a non-link is a false affordance. Emphasis comes from
     sentence construction and structure. Deliberately no `mark` rule here: an unstyled <mark>
     falls back to the browser default, which is loud enough that nobody ships it by accident. */
  .lead p:first-child { font-size: 20px; line-height: 1.6; }
  .fig { margin: 32px 0 8px; }
  .fig-cap {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-dim); margin: 16px 0 0;
  }
  .fig-cap b { color: var(--loch); font-weight: 500; }
  /* Labelled-row list: a short mono label, then a line of prose. Ported to base S16 from
     route-dont-guess's own scoped .taxes/.tax-* (pilot-era), generically renamed on its
     second use (the burn-window cold open in invoked-not-executed). Borders only — no fill,
     no radius — the same no-container family as .pull and the table. The .dominant modifier
     flags the one row that carries the most weight and prints a small "dominant" tag. */
  .stat-rows { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin: 32px 0 8px; }
  .stat-row {
    display: grid; grid-template-columns: minmax(0,140px) 1fr; gap: 20px;
    padding: 20px 0; border-top: 1px solid var(--rule); align-items: baseline;
  }
  .stat-row:first-child { border-top: none; }
  .stat-name {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--loch); font-weight: 500;
  }
  .stat-desc { font-size: 16px; line-height: 1.55; color: var(--ink); margin: 0; }
  .stat-row.dominant .stat-name { color: var(--moss); }
  .stat-row.dominant .stat-name::after {
    content: "dominant"; display: block; margin-top: 6px; font-size: 11px;
    letter-spacing: 0.06em; color: var(--ink-dim);
  }
  /* Discrete-trial outcome matrix: a small grid of binary results across two axes (here
     phrasing x model tier). New S16 in invoked-not-executed. Kept generic — any two-axis set
     of pass/fail trials fits it unchanged (R1). House no-container grammar: hairline rules
     only, no cell fill, no radius, so the 6-cell matrix cannot read as the filled-tile
     fingerprint. State is a mark, not a tile — a solid block for the positive outcome
     (echoing the wordmark cursor), a hollow outline for the negative. Loch marks the positive
     as figure-series-1, never as an interactive affordance. */
  .trials {
    display: grid; grid-template-columns: minmax(0,1fr) minmax(0,132px) minmax(0,132px);
    border-top: 1px solid var(--rule); margin: 32px 0 8px;
  }
  .trial-h {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-dim); font-weight: 500;
    padding: 10px 14px 10px 0; border-bottom: 1px solid var(--rule);
  }
  .trial-r {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em;
    text-transform: uppercase; color: var(--ink); font-weight: 500;
    padding: 15px 14px 15px 0; border-bottom: 1px solid var(--rule); align-self: center;
  }
  .trial {
    display: flex; align-items: center; gap: 9px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em;
    padding: 15px 14px 15px 0; border-bottom: 1px solid var(--rule);
  }
  .trial::before { content: ""; width: 11px; height: 11px; flex: none; box-sizing: border-box; }
  .trial.yes { color: var(--loch); }
  .trial.yes::before { background: var(--loch); }
  .trial.no { color: var(--ink-dim); }
  .trial.no::before { border: 1.5px solid var(--ink-dim); }
  /* Requirement ledger — six voices/candidates against N requirements, three states because two
     would lie: met, broke, and never established (a candidate never run far enough to find out).
     A real table (free header association), hairlines only, no box/fill/radius so R4 cannot apply.
     First trial: tts-voice-hunt, S9/S18. Generic — any candidates-vs-requirements set fits (R1). */
  .ledger { width: 100%; border-collapse: collapse; margin: 0; }
  .ledger caption { display: none; }
  .ledger th, .ledger td { padding: 0; text-align: left; vertical-align: baseline; }
  .ledger thead th {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 400;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim);
    padding-bottom: 12px; line-height: 1.35;
  }
  .ledger thead th.axis { width: 74px; text-align: center; }
  .ledger tr.voice > * { border-top: 1px solid var(--rule); padding-top: 16px; }
  .ledger th.name {
    font-family: var(--font-display); font-weight: 700; font-size: 18px;
    letter-spacing: -0.015em; color: var(--moss); line-height: 1.3; padding-right: 20px;
  }
  .ledger th.name .eng {
    display: block; font-family: var(--font-mono); font-size: 10.5px; font-weight: 400;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim); margin-top: 5px;
  }
  .ledger td.cell { text-align: center; }
  .ledger tr.why td {
    font-size: 15px; line-height: 1.5; color: var(--ink-dim);
    padding: 8px 0 20px;
  }
  .ledger tr.why em { font-style: italic; color: var(--ink); }
  /* Visually hidden but screen-reader-readable. Only reads state text ("met"/"broke") next to a
     cell's glyph — the key at the bottom carries the same words visibly, so nothing is lost. */
  .sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  /* State glyphs: tick / cross / circle, using the site's existing good/bad/warn semantic tokens
     rather than inventing new colour. Drawn with CSS strokes, not an icon font or emoji, so every
     glyph carries the same weight and theme-adapts for free. */
  .m { display: inline-block; width: 11px; height: 11px; position: relative; top: -1px; margin-right: 6px; }
  .m.met {
    width: 9px; height: 5px; margin-right: 8px;
    border-left: 2px solid var(--good); border-bottom: 2px solid var(--good);
    transform: rotate(-45deg); top: -3px;
  }
  .m.broke { background: none; }
  .m.broke::before, .m.broke::after {
    content: ""; position: absolute; left: 4px; top: -1px;
    width: 2px; height: 12px; background: var(--bad); border-radius: 1px;
  }
  .m.broke::before { transform: rotate(45deg); }
  .m.broke::after { transform: rotate(-45deg); }
  .m.unrun { border: 1.5px solid var(--warn); border-radius: 50%; }
  .key {
    display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 20px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--ink-dim);
  }
  .key span { display: inline-flex; align-items: baseline; gap: 10px; }
  @media (max-width: 620px) {
    /* The ledger unstacks: each voice becomes its own hairline-ruled block, axes carried inline
       as labels so nothing is inferred from column position. */
    .ledger, .ledger tbody, .ledger tr, .ledger th, .ledger td { display: block; }
    .ledger thead { display: none; }
    .ledger tr.voice > * { border-top: 0; padding-top: 0; }
    .ledger tr.voice { border-top: 1px solid var(--rule); padding-top: 16px; }
    .ledger th.name { padding-right: 0; }
    .ledger tr.voice td.cell {
      display: inline-flex; align-items: baseline; gap: 7px;
      padding: 0 16px 0 0; margin-top: 12px;
      font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.05em;
      text-transform: uppercase; color: var(--ink-dim);
    }
    .ledger tr.voice td.cell::after { content: attr(data-axis); }
    .ledger tr.why td { padding: 10px 0 22px; }
  }
  .pull {
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    padding: 24px 0; margin: 32px 0; font-family: var(--font-display);
    font-weight: 700; font-size: 23px; line-height: 1.3; letter-spacing: -0.01em;
  }
  /* Prompt device — deliberately .pull's sibling (same rules, no box) carrying mono instead of
     display type, so it reuses furniture the reader already knows and adds no container signals.
     Two sanctioned uses only: a command genuinely run, or `echo` as a terminal aside. Never an
     invented verb, which would claim a transcript that never existed. Sparing: ~1-2 per piece,
     never two in consecutive paragraphs. Static, never animated. */
  .cmd {
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    padding: 20px 0; margin: 30px 0; font-family: var(--font-mono);
    font-size: 15px; line-height: 1.5;
  }
  .cmd .p { color: var(--moss); margin-right: 0.7ch; }
  .cmd .out { display: block; color: var(--ink-dim); margin-top: 8px; font-size: 14px; }
  .open-note {
    font-size: 16px; color: var(--ink-dim);
    border-top: 1px solid var(--rule); padding-top: 32px; margin-top: 40px;
  }
  footer { border-top: 1px solid var(--rule); padding: 40px 0 56px; }
  footer .wrap { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  footer .fw { font-family: var(--font-mono); font-weight: 700; font-size: 16px; color: var(--ink); }
  footer .fmeta {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-dim);
  }
  @media (max-width: 560px) {
    body { font-size: 17px; }
    .wrap { padding: 0 18px; }
    .masthead .wrap { flex-wrap: wrap; gap: 10px; }
    /* Narrow screens wrap code instead of scrolling it. At 420px a terminal-width
       block hides ~46% of itself off-screen with no visible affordance, and a
       sideways scroll nobody discovers is the same as truncated evidence. Desktop
       keeps overflow-x: auto, where the overflow is marginal. */
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
    .stat-row { grid-template-columns: 1fr; gap: 6px; }
    /* Matrix stays a matrix on mobile — proportional columns keep the two data cells wide
       enough for "not invoked" and let the row label wrap rather than overflow. */
    .trials { grid-template-columns: minmax(0,1.1fr) 1fr 1fr; }
  }
</style>
</head>
<body>
  <header class="masthead">
    <div class="wrap">
      <a class="wordmark" href="/"><span class="wm-mark" aria-hidden="true">&rsaquo;</span><span class="wm-the">the</span><span class="wm-kilted">kilted</span><span class="wm-dev">dev</span><span class="wm-cursor" aria-hidden="true"></span></a>
      <nav class="masthead-nav">
        <a href="/about/">about</a>
        <a href="/feed.xml">rss</a>
        <button class="theme-toggle" id="tt" type="button" aria-label="Toggle colour theme">theme</button>
      </nav>
    </div>
  </header>

  <main id="top">
    {{ content | safe }}
  </main>

  <footer>
    <div class="wrap">
      <span class="fw"><span class="wm-the">the</span><span class="wm-kilted">kilted</span><span class="wm-dev">dev</span></span>
      <span class="fmeta">{{ site.tagline }}</span>
    </div>
  </footer>

  <script data-goatcounter="https://thekilteddev.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

  <script>
    (function () {
      var btn = document.getElementById('tt');
      var root = document.documentElement;
      btn.addEventListener('click', function () {
        var cur = root.getAttribute('data-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var next = cur ? (cur === 'dark' ? 'light' : 'dark')
                       : (prefersDark ? 'light' : 'dark');
        root.setAttribute('data-theme', next);
      });
    })();
  </script>
</body>
</html>
